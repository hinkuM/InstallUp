Port {{ ssh_port }}
Protocol 2
AddressFamily inet

PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
MaxAuthTries 5

AllowUsers {{ new_admin_user }}
IgnoreRhosts yes
HostbasedAuthentication no
PermitEmptyPasswords no

ClientAliveInterval 300
ClientAliveCountMax 2
LoginGraceTime 60

LogLevel VERBOSE
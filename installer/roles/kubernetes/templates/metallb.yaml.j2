apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: live-ip-pool
  namespace: metallb-system
spec:
  addresses:
  {% for item in ip_pool_load_balancer %}
  - {{ item }}
  {% endfor %}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: metallb
  namespace: metallb-system
spec:
  ipAddressPools:
  - live-ip-pool
